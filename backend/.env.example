APP_ADDRESS=:8080
DB_PATH=/app/data/app.db
UPLOAD_DIR=/app/data/uploads
JWT_SECRET=change-me
TOKEN_TTL_HOURS=24
REFRESH_TOKEN_TTL_DAYS=3650
PUBLIC_BASE_URL=https://daily.example.tld
# Optional: internal admin/browser URL if different from PUBLIC_BASE_URL.
ADMIN_BASE_URL=http://admin.daily.local:13379
# Comma-separated browser origins allowed for CORS.
# Must include every browser URL that accesses backend/admin.
# PUBLIC_BASE_URL and ADMIN_BASE_URL origins are auto-added by backend when valid.
CORS_ORIGINS=http://localhost:13379,https://daily.example.tld
APP_TIMEZONE=Europe/Berlin
SCHEDULER_ENABLED=true
SCHEDULER_LEASE_TIMEOUT_SEC=60
APP_VERSION=dev
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong
FCM_ENABLED=false
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_FILE=/app/secrets/firebase-service-account.json
FORENSIC_BACKEND_LOG_PATH=/app/logs/backend.log
FORENSIC_GATEWAY_LOG_PATH=/app/gateway-logs/access.log
MEDIA_RENDITIONS_ENABLED=true
# Enables the encoder/runtime capability. Operators can still pause delivery
# immediately in Admin → Medien & AVIF without deleting originals or fallbacks.
MEDIA_AVIF_ENABLED=true
MEDIA_DERIVATIVE_MAX_BYTES=5368709120
RENDITION_LOG_OFFSET_PATH=/app/data/rendition-gateway.offset
SQLITE_MAX_OPEN_CONNS=1
SQLITE_MAX_IDLE_CONNS=1
# Exactly 32 random bytes, standard Base64. Keep outside the repository.
EMAIL_MASTER_KEY_B64=
# Optional during key rotation only. Remove after all values were lazily re-encrypted.
EMAIL_PREVIOUS_MASTER_KEY_B64=
# Comma-separated HTTPS hosts accepted for action links.
EMAIL_ALLOWED_ACTION_HOSTS=daily.example.tld,daily-alt.example.tld
ANDROID_APP_PACKAGE=com.selfhosted.daily
# Comma-separated release/debug signing SHA-256 fingerprints (colon notation).
ANDROID_APP_CERT_SHA256=

